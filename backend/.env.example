# ── SIPAM-USCO — Variables de entorno ─────────────────────────────────────────
# Copia este archivo como .env y ajusta los valores antes de iniciar el backend.

# ── Seguridad ─────────────────────────────────────────────────────────────────
SECRET_KEY=cambia-esta-clave-en-produccion-min-32-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEBUG=False

# Contraseña del superusuario administrador (codigo: Krlitoxprz)
ADMIN_PASSWORD=cambia-esta-contrasena-admin

# ── Base de datos ─────────────────────────────────────────────────────────────
# Desarrollo (SQLite — sin instalar nada):
# DATABASE_URL=sqlite:///./sipam_usco.db

# Producción (PostgreSQL):
DATABASE_URL=postgresql://sipam_user:sipam_pass@localhost:5432/sipam_db

# ── CORS (orígenes permitidos del frontend) ───────────────────────────────────
# CORS_ORIGINS=["https://sipam.usco.edu.co"]

# ── Almacenamiento de archivos ────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ── OpenRouteService (cálculo de rutas reales) ────────────────────────────────
# Regístrate gratis en https://openrouteservice.org y copia tu API key:
ORS_API_KEY=

# ── SMTP (recuperación de contraseña por email) ───────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=correo@usco.edu.co
SMTP_PASS=contraseña-app
SMTP_FROM=sipam@usco.edu.co
SMTP_TLS=True

# ── URL pública del frontend ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
