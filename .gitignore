.env.local
.env.*.local
.env.production
!.env.production.example

# ── Base de datos SQLite ──────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Archivos subidos por usuarios ─────────────────────────────────────────────
backend/uploads/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

