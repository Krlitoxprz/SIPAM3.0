*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
*.pyo

# ── Entornos virtuales ────────────────────────────────────────────────────────
venv/
.venv/
env/
.env/
ENV/

