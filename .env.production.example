# ── SIPAM-USCO — Variables de entorno de producción ────────────────────────────
# Copia este archivo como .env.production y rellena los valores antes de deployar.
# NUNCA subas .env.production al repositorio.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=sipam_db
POSTGRES_USER=sipam_user
POSTGRES_PASSWORD=CAMBIA_ESTA_PASSWORD_SEGURA

# ── FastAPI Backend ───────────────────────────────────────────────────────────
SECRET_KEY=GENERA_UNA_CLAVE_SEGURA_CON_openssl_rand_-hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEBUG=False
ADMIN_PASSWORD=CAMBIA_PASSWORD_ADMIN

# La URL de la BD se construye automáticamente en docker-compose.yml:
# DATABASE_URL=postgresql://sipam_user:PASSWORD@db:5432/sipam_db

# ── Dominio de producción ─────────────────────────────────────────────────────
# Reemplaza con tu IP o dominio real del servidor Ubuntu
FRONTEND_URL=http://TU_IP_O_DOMINIO
CORS_ORIGINS=http://TU_IP_O_DOMINIO,https://TU_IP_O_DOMINIO

# ── SMTP (correo electrónico) — opcional ────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password
SMTP_FROM=no-reply@usco.edu.co
SMTP_TLS=True

# ── OpenRouteService (cálculo de rutas) — opcional ──────────────────────────
ORS_API_KEY=
